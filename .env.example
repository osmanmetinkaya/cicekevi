# Stripe — https://dashboard.stripe.com/test/apikeys (test mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Created when you run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build absolute success/cancel URLs. Optional in dev (falls back to request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard → Project Settings → API
# Üyelik + sipariş geçmişi bu anahtarlar girilince aktifleşir.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Yalnızca sunucu (webhook sipariş kaydı) — tarayıcıya asla sızmaz.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
