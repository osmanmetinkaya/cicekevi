# PayTR — https://www.paytr.com mağaza paneli → Bilgi (API Entegrasyon Bilgileri)
# Gerçek değerleri buraya YAZMA; .env.local ve Vercel ortam değişkenlerine gir.
PAYTR_MERCHANT_ID=000000
PAYTR_MERCHANT_KEY=xxxxxxxxxxxxxxxx
PAYTR_MERCHANT_SALT=xxxxxxxxxxxxxxxx

# PayTR mağaza panelinde "Bildirim URL" olarak şu adres tanımlanmalı
# (kod içinde gönderilmiyor):
#   https://denizlicicekevi.online/api/paytr/callback

# Ödeme dönüş (success) URL'lerini mutlak üretmek için. Dev'de opsiyonel
# (istek origin'ine düşer).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard → Project Settings → API
# Üyelik + sipariş geçmişi bu anahtarlar girilince aktifleşir.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Yalnızca sunucu (sipariş kaydı + PayTR callback) — tarayıcıya asla sızmaz.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — https://resend.com/api-keys. Ödeme başarılı olduğunda (PayTR
# callback) mağaza sahibine yeni sipariş bildirimi, müşteriye de sipariş
# fişi gönderilir. Tanımlı değilse mail gönderimi sessizce atlanır.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Resend'de doğrulanmış bir gönderen adresi/domaini olmalı.
EMAIL_FROM="Denizli Çiçekevi <siparis@denizlicicekevi.online>"
# Yeni sipariş bildiriminin gideceği mağaza e-postası.
ORDER_NOTIFY_EMAIL=denizlicicekevi20@gmail.com
